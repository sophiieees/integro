# Dependencias (no se usan en el prototipo; se dejan por si entra Next.js)
node_modules/
.next/
# Secretos: nunca en el repositorio (ver docs/arquitectura.md, sección Seguridad)
.env
.env.*
# La plantilla sí se sube: trae los nombres de las variables, sin contraseña
!.env.example
# Sistema
.DS_Store
Thumbs.db
*.log
# Recortes temporales del generador del Word
herramientas/bitacora/salida/
__pycache__/
*.pyc
# Backend en Python: entorno virtual y caché de las pruebas
.venv/
.pytest_cache/
