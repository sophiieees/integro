# Plantilla de las variables de entorno del backend.
# Copia este archivo como .env, en esta misma carpeta, y escribe la contraseña.
# El archivo .env nunca se sube al repositorio: git lo ignora.

# Dónde está PostgreSQL. En desarrollo: la computadora de Sophia, puerto 5433.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=integro

# Usuario con el que la API inicia sesión en la base. Se crea fuera del
# repositorio y es miembro de los papeles integro_app e integro_service.
DATABASE_USER=integro_api

# La contraseña se escribe solo en .env. Aquí se queda vacía.
DATABASE_PASSWORD=

# Llave secreta para calcular la huella de los códigos de un solo uso.
# Mínimo 32 caracteres, al azar. Se genera y se guarda solo en .env; el
# README dice cómo. Aquí se queda vacía.
CODE_HASH_SECRET=

# Cómo salen los correos. console: modo desarrollo, el código se escribe en la
# ventana del servidor en lugar de enviarse. No usar con personas reales.
EMAIL_DELIVERY=console

# Límites de los códigos. Opcionales: estos son los valores decididos.
# CODE_LENGTH=6
# CODE_TTL_SECONDS=300
# CODE_MAX_ATTEMPTS=5
# CODE_RESEND_WAIT_SECONDS=60
# CODE_MAX_PER_HOUR=5

# Contraseñas incorrectas. Opcionales: estos son los valores decididos.
# LOGIN_NOTICE_AFTER_FAILURES=3
# LOGIN_WAIT_AFTER_FAILURES=6
# LOGIN_WAIT_MINUTES=15

# Días sin uso que aguanta una sesión. Opcionales.
# SESSION_IDLE_DAYS_GUEST=30
# SESSION_IDLE_DAYS_HOST=7
