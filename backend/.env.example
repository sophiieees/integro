# Plantilla de las variables de entorno del backend.
# Copia este archivo como .env, en esta misma carpeta, y escribe la contraseña.
# El archivo .env nunca se sube al repositorio: git lo ignora.

# Dónde está PostgreSQL. En desarrollo: la computadora de Sophia, puerto 5433.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=integro

# Usuario con el que la API inicia sesión en la base. Se crea fuera del
# repositorio y es miembro de los papeles integro_app e integro_service.
DATABASE_USER=integro_api

# La contraseña se escribe solo en .env. Aquí se queda vacía.
DATABASE_PASSWORD=

# Llave secreta para calcular la huella de los códigos de un solo uso.
# Mínimo 32 caracteres, al azar. Se genera y se guarda solo en .env; el
# README dice cómo. Aquí se queda vacía.
CODE_HASH_SECRET=

# Cómo salen los correos. console: modo desarrollo, el código se escribe en la
# ventana del servidor en lugar de enviarse. No usar con personas reales.
EMAIL_DELIVERY=console
# Correo real con Resend (solo en Vercel; en esta computadora se queda en console). Con EMAIL_DELIVERY=resend hacen
# falta las dos, y si falta una la API no arranca. La llave se escribe solo en las variables del proveedor, nunca aquí.
# EMAIL_API_KEY=
# EMAIL_FROM=Íntegro <no-responder@tu-dominio>

# Límites de los códigos. Opcionales: estos son los valores decididos.
# CODE_LENGTH=6
# CODE_TTL_SECONDS=300
# CODE_MAX_ATTEMPTS=5
# CODE_RESEND_WAIT_SECONDS=60
# CODE_MAX_PER_HOUR=5
# El código de recuperar la contraseña dura más (30 minutos).
# PASSWORD_RESET_TTL_SECONDS=1800

# Contraseñas incorrectas. Opcionales: estos son los valores decididos.
# LOGIN_NOTICE_AFTER_FAILURES=3
# LOGIN_WAIT_AFTER_FAILURES=6
# LOGIN_WAIT_MINUTES=15

# Días sin uso que aguanta una sesión. Opcionales.
# Conexión con la base. Opcionales. En la nube (Neon): DATABASE_SSLMODE=require y un tiempo de espera mayor,
# porque la primera conexión después de que la base se suspendió tarda más.
# DATABASE_SSLMODE=prefer
# DATABASE_CONNECT_TIMEOUT_SECONDS=3
# Detrás de un proxy (Vercel): creer en X-Forwarded-For y X-Forwarded-Proto. Solo donde el proxy los reescribe siempre.
# TRUST_PROXY_HEADERS=false

# SESSION_IDLE_DAYS_GUEST=30
# SESSION_IDLE_DAYS_HOST=7
# Quien es administrador: minutos sin uso y horas desde que inicia sesión. Opcionales.
# SESSION_IDLE_MINUTES_ADMIN=30
# SESSION_MAX_HOURS_ADMIN=12

# CAPTCHA (Cloudflare Turnstile). Siempre activo: no hay interruptor. En esta computadora valen las llaves de PRUEBA
# de Cloudflare (públicas, siempre pasan); se quitan los «#» para usarlas. Las llaves reales van solo en Vercel. Las de
# prueba (empiezan con 1x, 2x o 3x) solo se aceptan con SESSION_COOKIE_SECURE=false; en la nube se rechazan (503).
# Sin llaves, la API arranca pero esas acciones contestan 503.
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Llave maestra para cifrar datos sensibles con AES-256-GCM (hoy, la clave del Authenticator). Al menos 43 caracteres
# al azar; el README dice cómo generarla. Se escribe solo en .env y en las variables del proveedor, una distinta en
# cada ambiente. Sin ella la API arranca, pero las rutas del Authenticator contestan 503. Aquí se queda vacía y
# comentada.
# DATA_ENCRYPTION_KEY=
# Authenticator: códigos incorrectos seguidos antes de esperar, y minutos de espera. Opcionales.
# TWO_FACTOR_MAX_ATTEMPTS=5
# TWO_FACTOR_WAIT_MINUTES=15

# La llave de sesión viaja en una cookie. Sin esta variable la cookie exige
# HTTPS. En desarrollo el servidor local no tiene HTTPS: aquí va en false.
# En la nube no se pone, o se pone en true.
SESSION_COOKIE_SECURE=false

# Direcciones desde las que una página puede pedir cambios con sesión, además
# de la dirección de la propia API, que siempre vale. Separadas por comas.
# En desarrollo no hace falta. Ejemplo: https://integro.mx,https://www.integro.mx
# ALLOWED_ORIGINS=

# La API muestra también las páginas de web/ en su misma dirección. Opcional:
# está encendido si la carpeta web/ existe junto a backend/.
# SERVE_WEB=true
